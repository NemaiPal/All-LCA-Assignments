#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    int choice, n;
    char str1[100], str2[100], ch, sub[50];

    while (1) {
        printf("\n===== String Operations Menu =====\n");
        printf("1. Find length (strlen)\n");
        printf("2. Copy string (strcpy)\n");
        printf("3. Concatenate strings (strcat)\n");
        printf("4. Compare strings (strcmp)\n");
        printf("5. Find character (strchr)\n");
        printf("6. Find Substring (strstr)\n");
        printf("7. Tokenize string (strtok)\n");
        printf("8. Convert to uppercase\n");
        printf("9. Convert to lowercase\n");
        printf("10. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        getchar(); // to consume newline

        switch (choice) {
            case 1:
                printf("Enter string: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                printf("Length = %d\n", (int)strlen(str1));
                break;

            case 2:
                printf("Enter Source String: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                strcpy(str2, str1);
                printf("Copied String: %s\n", str2);
                break;

            case 3:
                printf("Enter first string: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                printf("Enter second string: ");
                fgets(str2, sizeof(str2), stdin);
                str2[strcspn(str2, "\n")] = '\0';
                strcat(str1, str2);
                printf("Concatenated String: %s\n", str1);
                break;

            case 4:
                printf("Enter first string: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                printf("Enter second string: ");
                fgets(str2, sizeof(str2), stdin);
                str2[strcspn(str2, "\n")] = '\0';
                n = strcmp(str1, str2);
                if (n == 0)
                    printf("Strings are equal\n");
                else if (n < 0)
                    printf("String 1 is less than String 2\n");
                else
                    printf("String 1 is greater than String 2\n");
                break;

            case 5: {
                char *result;
                printf("Enter String: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                printf("Enter character to find: ");
                ch = getchar();
                getchar();
                result = strchr(str1, ch);
                if (result != NULL)
                    printf("Character found at position: %d\n", (int)(result - str1));
                else
                    printf("Character not found\n");
                break;
            }

            case 6: {
                char *result;
                printf("Enter String: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                printf("Enter Substring to find: ");
                fgets(sub, sizeof(sub), stdin);
                sub[strcspn(sub, "\n")] = '\0';
                result = strstr(str1, sub);
                if (result != NULL)
                    printf("Substring found at position: %d\n", (int)(result - str1));
                else
                    printf("Substring not found\n");
                break;
            }

            case 7: {
                char *token;
                printf("Enter String: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                token = strtok(str1, " ");
                printf("Tokens:\n");
                while (token != NULL) {
                    printf("%s\n", token);
                    token = strtok(NULL, " ");
                }
                break;
            }

            case 8: {
                int i;
                printf("Enter String: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                for (i = 0; str1[i] != '\0'; i++)
                    str1[i] = toupper(str1[i]);
                printf("Uppercase: %s\n", str1);
                break;
            }

            case 9: {
                int i;
                printf("Enter String: ");
                fgets(str1, sizeof(str1), stdin);
                str1[strcspn(str1, "\n")] = '\0';
                for (i = 0; str1[i] != '\0'; i++)
                    str1[i] = tolower(str1[i]);
                printf("Lowercase: %s\n", str1);
                break;
            }

            case 10:
                printf("Exiting program.\n");
                return 0;

            default:
                printf("Invalid choice, Try again.\n");
        }
    }
}
