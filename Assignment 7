#include <stdio.h>

struct Robot {
    int id;
    char type[20];
    float capacity;   // Payload capacity (kg)
    float load;       // Actual load (kg)
    float time;       // Operating time (hours)
};

int main() {
    int n, i;
    struct Robot r[10];

    printf("Enter number of robots: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter details for robot %d\n", i + 1);

        printf("Robot ID: ");
        scanf("%d", &r[i].id);

        printf("Robot Type: ");
        scanf("%s", r[i].type);

        printf("Payload Capacity (kg): ");
        scanf("%f", &r[i].capacity);

        printf("Actual Load (kg): ");
        scanf("%f", &r[i].load);

        printf("Operating Time (hours): ");
        scanf("%f", &r[i].time);
    }

    printf("\n%-5s %-15s %-10s %-10s %-10s %-10s %s\n",
           "ID", "Type", "Capacity", "Load", "Time", "Util(%)", "Status");

    for (i = 0; i < n; i++) {
        float util = (r[i].load / r[i].capacity) * 100;

        printf("%-5d %-15s %-10.2f %-10.2f %-10.2f %-10.2f",
               r[i].id, r[i].type, r[i].capacity, r[i].load,
               r[i].time, util);

        if (r[i].load > r[i].capacity)
            printf("Overloaded\n");
        else
            printf("Within Limit\n");
    }

    return 0;
}
